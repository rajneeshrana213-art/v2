{
  "name": "learnxchain-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@learnxchain/web",
    "dev:mobile": "turbo dev --filter=@learnxchain/mobile",
    "dev:ai": "turbo dev --filter=@learnxchain/ai",
    "dev:lms": "turbo dev --filter=@learnxchain/lms",
    "build": "turbo build",
    "build:web": "turbo build --filter=@learnxchain/web",
    "build:ai": "turbo build --filter=@learnxchain/ai",
    "build:lms": "turbo build --filter=@learnxchain/lms",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "clean": "turbo clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "prisma": "^7.6.0",
    "turbo": "^2.9.4"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0"
  }
}

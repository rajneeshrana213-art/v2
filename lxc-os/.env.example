APP_ENV=development
# APP_ENV=production 

# Test DataBase DB
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"

# Login with Google Secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

INIT_MASTER_KEY=your_master_key

# Leave empty to use local face matcher
# FACE_SERVICE_URL=http://localhost:5002
# TIMETABLE_AI_URL= http://localhost:8000/generate-timetable

# production
FACE_SERVICE_URL=https://rit.academics-pro.com/api/face
TIMETABLE_AI_URL=https://rit.academics-pro.com/api/generate-timetable
AI_TIMEOUT_MS=15_000        

FACE_MODEL_PATH=./models

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=your_jwt_access_secret
JWT_REFRESH_TOKEN_SECRET=your_jwt_refresh_secret
JWT_SECRET=your_jwt_secret

# Frontend URL
FRONTEND_URL=https://academics-pro.com

# Email Server Configuration
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD="your_app_password"
SENDGRID_API_KEY="SG.your_sendgrid_key"
EMAIL_FROM="your_email@gmail.com"

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID="SENDER"

# Zoom Configuration
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_BASE_URL=https://api.zoom.us/v2
ZOOM_REDIRECT_URI=http://localhost:5000/api/zoom/callback

# Port Configuration
PORT=5000

# Test Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
TRIAL_PRICE=2

# Stream Configuration
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
STREAM_APP_ID=your_stream_app_id

# Redis Configuration
REDIS_URL="redis://default:password@host:port"

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Google Search Console
GSC_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GSC_PROPERTY_URI="https://academics-pro.com/"

# --- Generative AI Provider Credentials (apps/ai) ---

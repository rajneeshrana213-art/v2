  schoolId  String   @unique @map("school_id")
  keyId     String   @map("key_id")
  keySecret String   @map("key_secret")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  coins     Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Transaction {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  coinsUsed  Int               @map("coins_used")
  amountPaid Float             @map("amount_paid")
  status     TransactionStatus @default(PENDING) @map("status")
  createdAt  DateTime          @default(now()) @map("created_at")
  user       User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model IssueTransaction {
  id          String        @id @default(cuid())
  memberId    String        @map("member_id")
  bookCopyId  String        @map("book_copy_id")
  issueDate   DateTime      @default(now()) @map("issue_date")
  dueDate     DateTime      @map("due_date")
  returnDate  DateTime?     @map("return_date")
  status      IssueStatus   @default(ISSUED)
  fineAmount  Float         @default(0.0) @map("fine_amount")

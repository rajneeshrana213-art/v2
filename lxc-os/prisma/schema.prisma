// ******************* Transport ******************************

model Transport {
  id        String    @id @default(cuid())
  schoolId  String    @map("school_id")
  userId    String    @unique @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([isDeleted])
}

model Bus {
  id                String                @id @default(cuid())
  busNumber         String                @map("bus_number")
  capacity          Int
  schoolId          String                @map("school_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at")
  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  busAttendance     BusAttendance[]
  maintenanceAlerts BusMaintenanceAlert[]
  conductors        Conductor[]
  drivers           Driver[]
  routes            Route[]
  students          Student[]
  trips             Trip[]
  attendances       Attendance[]          @relation("AttendanceToBus")

  @@index([busNumber])
  @@index([schoolId])
  @@index([schoolId, busNumber])
}

model Driver {
  id                 String                   @id @default(cuid())
  currentLat         Float?                   @map("current_lat")
  currentLng         Float?                   @map("current_lng")
  license            String                   @unique
  busId              String?                  @map("bus_id")
  userId             String                   @unique @map("user_id")
  schoolId           String                   @map("school_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at")
  currentLocationId  String?                  @map("current_location_id")
  routeActive        Boolean                  @default(false) @map("route_active")
  deviceId           String?                  @map("device_id")
  pushToken          String?                  @map("push_token")
  profilePhoto       String?                  @map("profile_photo")
  licensePhoto       String?                  @map("license_photo")
  bus                Bus?                     @relation(fields: [busId], references: [id], onDelete: Cascade)
  currentLocation    DriverLocation?          @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  behaviorIncidents  DriverBehaviorIncident[]
  DriverLocation     DriverLocation[]
  DriverNotification DriverNotification[]
  performanceScores  DriverPerformanceScore[]
  trips              Trip[]

  @@index([schoolId])
  @@index([busId])
  @@index([userId])
  @@index([license])
  @@index([routeActive])
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String   @map("driver_id")
  latitude  Float
  longitude Float
  speed     Float
  timestamp DateTime @default(now()) @map("timestamp")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  Driver    Driver[] @relation("CurrentLocation")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([timestamp])
  @@index([driverId, timestamp])
}

model DriverNotification {
  id        String   @id @default(cuid()) @map("notification_id")
  driverId  String   @map("driver_id")
  type      String   @map("notification_type")
  content   String   @map("notification_content")
  isRead    Boolean  @default(false) @map("is_read")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Conductor {
  id        String   @id @default(cuid())
  name      String
  busId     String   @map("bus_id")
  schoolId  String   @map("school_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([busId])
  @@index([schoolId])
}

model Route {
  id            String              @id @default(cuid())
  name          String
  busId         String              @map("bus_id")
  schoolId      String              @map("school_id")
  distance      Float?              @map("distance")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")
  busStops      BusStop[]
  pickUpPoint   PickUpPoint[]
  bus           Bus                 @relation(fields: [busId], references: [id], onDelete: Cascade)
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  optimizations RouteOptimization[]
  students      Student[]
  trips         Trip[]

  @@index([schoolId])
  @@index([busId])
  @@index([schoolId, busId])
}

model BusStop {
  id        String     @id @default(cuid())
  name      String
  location  String
  latitude  Float?     @map("latitude")
  longitude Float?     @map("longitude")
  routeId   String?    @map("route_id")
  schoolId  String     @map("school_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  route     Route?     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Student[]
  tripStops TripStop[]

  @@index([schoolId])
  @@index([routeId])
  @@index([schoolId, routeId])
}

model PickUpPoint {
  id        String    @id @default(cuid())
  name      String
  location  String
  routeId   String    @map("route_id")
  schoolId  String    @map("school_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Student[]

  @@index([schoolId])
  @@index([routeId])
  @@index([schoolId, routeId])
}

model BusAttendance {
  id        String              @id @default(cuid())
  studentId String              @map("student_id")
  busId     String              @map("bus_id")
  date      DateTime            @default(now())
  status    BusAttendanceStatus @default(BOARDED)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")
  tripId    String?             @map("trip_id")
  bus       Bus                 @relation(fields: [busId], references: [id], onDelete: Cascade)
  student   Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trip      Trip?               @relation(fields: [tripId], references: [id])

  @@unique([studentId, tripId])
  @@index([studentId])
  @@index([busId])
  @@index([tripId])
  @@index([date])
  @@index([studentId, date])
}

model Trip {
  id                String                   @id @default(cuid())
  driverId          String                   @map("driver_id")
  routeId           String?                  @map("route_id")
  busId             String                   @map("bus_id")
  schoolId          String                   @map("school_id")
  startedAt         DateTime                 @default(now()) @map("started_at")
  endedAt           DateTime?                @map("ended_at")
  status            TripStatus               @default(ACTIVE)
  degraded          Boolean                  @default(false) @map("is_degraded")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at")
  type              TripType                 @default(MORNING)
  busAttendance     BusAttendance[]
  behaviorIncidents DriverBehaviorIncident[]
  bus               Bus                      @relation(fields: [busId], references: [id], onDelete: Cascade)
  driver            Driver                   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route             Route?                   @relation(fields: [routeId], references: [id])
  school            School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripLocations     TripLocation[]
  notifications     TripNotification[]
  tripStops         TripStop[]

  @@index([driverId])
  @@index([status])
  @@index([degraded])
}

model TripStop {
  id              String    @id @default(cuid())
  tripId          String    @map("trip_id")
  busStopId       String    @map("bus_stop_id")
  latitude        Float     @map("stop_latitude")
  longitude       Float     @map("stop_longitude")
  notified        Boolean   @default(false) @map("is_notified")
  arrived         Boolean   @default(false) @map("is_arrived")
  arrivedAt       DateTime? @map("arrived_at")
  expectedArrival DateTime? @map("expected_arrival")
  actualArrival   DateTime? @map("actual_arrival")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  busStop         BusStop   @relation(fields: [busStopId], references: [id], onDelete: Cascade)
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([busStopId])
}

model TripLocation {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  latitude  Float    @map("latitude")
  longitude Float    @map("longitude")
  speed     Float?   @map("speed")
  accuracy  Float?   @map("accuracy")
  heading   Float?   @map("heading")
  timestamp DateTime @default(now()) @map("timestamp")
  createdAt DateTime @default(now()) @map("created_at")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([timestamp])
}

model TripNotification {
  id              String                 @id @default(cuid())
  tripId          String?                @map("trip_id")
  event           String                 @map("event_type")
  recipient       String                 @map("recipient")
  message         String                 @map("message")
  status          TripNotificationStatus @default(PENDING) @map("status")
  webhookUrl      String?                @map("webhook_url")
  webhookSent     Boolean                @default(false) @map("webhook_sent")
  webhookResponse Json?                  @map("webhook_response")
  sentAt          DateTime?              @map("sent_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at")
  trip            Trip?                  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([status])
  @@index([event])
}

model DriverBehaviorIncident {
  id                String               @id @default(cuid())
  driverId          String               @map("driver_id")
  tripId            String?              @map("trip_id")
  schoolId          String               @map("school_id")
  type              BehaviorIncidentType @map("incident_type")
  severity          BehaviorSeverity     @default(MEDIUM) @map("severity")
  latitude          Float?               @map("latitude")
  longitude         Float?               @map("longitude")
  speed             Float?               @map("speed")
  heading           Float?               @map("heading")
  description       String               @map("description")
  threshold         Float?               @map("threshold")
  actualValue       Float?               @map("actual_value")
  durationSeconds   Int?                 @map("duration_seconds")
  expectedRouteId   String?              @map("expected_route_id")
  deviationDistance Float?               @map("deviation_distance")
  notifiedAdmin     Boolean              @default(false) @map("notified_admin")
  notifiedAt        DateTime?            @map("notified_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at")
  driver            Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trip              Trip?                @relation(fields: [tripId], references: [id])

  @@index([driverId])
  @@index([tripId])
  @@index([schoolId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@index([driverId, createdAt])
}

model DriverPerformanceScore {
  id               String   @id @default(cuid())
  driverId         String   @map("driver_id")
  schoolId         String   @map("school_id")
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  periodType       String   @map("period_type")
  overallScore     Float    @default(100) @map("overall_score")
  safetyScore      Float    @default(100) @map("safety_score")
  punctualityScore Float    @default(100) @map("punctuality_score")
  efficiencyScore  Float    @default(100) @map("efficiency_score")
  complianceScore  Float    @default(100) @map("compliance_score")
  totalTrips       Int      @default(0) @map("total_trips")
  totalDistance    Float    @default(0) @map("total_distance")
  totalDuration    Int      @default(0) @map("total_duration")
  incidentsCount   Int      @default(0) @map("incidents_count")
  onTimePercentage Float    @default(100) @map("on_time_percentage")
  averageSpeed     Float?   @map("average_speed")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([driverId, periodStart, periodEnd, periodType])
  @@index([driverId])
  @@index([schoolId])
  @@index([periodStart, periodEnd])
}

model RouteOptimization {
  id                 String    @id @default(cuid())
  routeId            String    @map("route_id")
  schoolId           String    @map("school_id")
  optimizationType   String    @map("optimization_type")
  originalDistance   Float     @map("original_distance")
  originalDuration   Int       @map("original_duration")
  originalStopCount  Int       @map("original_stop_count")
  optimizedDistance  Float     @map("optimized_distance")
  optimizedDuration  Int       @map("optimized_duration")
  optimizedStopOrder Json      @map("optimized_stop_order")
  estimatedSavings   Float     @map("estimated_savings")
  trafficConditions  String?   @map("traffic_conditions")
  weatherConditions  String?   @map("weather_conditions")
  isApplied          Boolean   @default(false) @map("is_applied")
  appliedAt          DateTime? @map("applied_at")
  appliedBy          String?   @map("applied_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  route              Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@index([schoolId])
  @@index([isApplied])
  @@index([createdAt])
}

model TransportAnalytics {
  id                   String   @id @default(cuid())
  schoolId             String   @map("school_id")
  periodStart          DateTime @map("period_start")
  periodEnd            DateTime @map("period_end")
  periodType           String   @map("period_type")
  totalBuses           Int      @default(0) @map("total_buses")
  activeBuses          Int      @default(0) @map("active_buses")
  busUtilizationRate   Float    @default(0) @map("bus_utilization_rate")
  totalRoutes          Int      @default(0) @map("total_routes")
  activeRoutes         Int      @default(0) @map("active_routes")
  totalDistance        Float    @default(0) @map("total_distance")
  averageRouteDistance Float    @default(0) @map("average_route_distance")
  totalTrips           Int      @default(0) @map("total_trips")
  completedTrips       Int      @default(0) @map("completed_trips")
  onTimeTrips          Int      @default(0) @map("on_time_trips")
  delayedTrips         Int      @default(0) @map("delayed_trips")
  onTimePercentage     Float    @default(0) @map("on_time_percentage")
  totalStudents        Int      @default(0) @map("total_students")
  studentsBoarded      Int      @default(0) @map("students_boarded")
  studentsAlighted     Int      @default(0) @map("students_alighted")
  averageBoardingTime  Float?   @map("average_boarding_time")
  totalDrivers         Int      @default(0) @map("total_drivers")
  activeDrivers        Int      @default(0) @map("active_drivers")
  averageDriverScore   Float?   @map("average_driver_score")
  totalIncidents       Int      @default(0) @map("total_incidents")
  estimatedFuelCost    Float?   @map("estimated_fuel_cost")
  maintenanceCost      Float?   @map("maintenance_cost")
  totalCost            Float?   @map("total_cost")
  costPerStudent       Float?   @map("cost_per_student")
  costPerKm            Float?   @map("cost_per_km")
  routeEfficiency      Json?    @map("route_efficiency")
  driverPerformance    Json?    @map("driver_performance")
  timeDistribution     Json?    @map("time_distribution")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, periodStart, periodEnd, periodType])
  @@index([schoolId])
  @@index([periodStart, periodEnd])
  @@index([periodType])
}

model BusMaintenanceAlert {
  id               String                  @id @default(cuid())
  busId            String                  @map("bus_id")
  schoolId         String                  @map("school_id")
  alertType        BusMaintenanceAlertType @map("alert_type")
  severity         BehaviorSeverity        @default(MEDIUM) @map("severity")
  title            String                  @map("title")
  message          String                  @map("message")
  predictedIssue   String?                 @map("predicted_issue")
  predictedDate    DateTime?               @map("predicted_date")
  confidence       Float?                  @map("confidence")
  currentMileage   Float?                  @map("current_mileage")
  daysSinceService Int?                    @map("days_since_service")
  isAcknowledged   Boolean                 @default(false) @map("is_acknowledged")
  acknowledgedAt   DateTime?               @map("acknowledged_at")
  acknowledgedBy   String?                 @map("acknowledged_by")
  isResolved       Boolean                 @default(false) @map("is_resolved")
  resolvedAt       DateTime?               @map("resolved_at")
  resolutionNotes  String?                 @map("resolution_notes")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at")
  bus              Bus                     @relation(fields: [busId], references: [id], onDelete: Cascade)
  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([busId])
  @@index([schoolId])
  @@index([isAcknowledged])
  @@index([isResolved])
  @@index([severity])
  @@index([createdAt])
}

enum BusMaintenanceAlertType {
  MILEAGE_BASED
  TIME_BASED
  CONDITION_BASED
  PREDICTIVE
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DEGRADED
}

enum TripType {
  MORNING
  RETURN
}

enum TripNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum BusAttendanceStatus {
  BOARDED
  ALIGHTED
  MISSED
}

// ******************* Student ******************************

model AdmissionCounter {
  schoolId     String    @map("school_id")
  academicYear String    @map("academic_year")
  nextSeq      Int       @default(1) @map("next_seq")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, academicYear])
  @@index([schoolId])
}

model StudentRemark {
  id        String   @id @default(cuid())
  remark    String
  studentId String   @map("student_id")
  teacherId String   @map("teacher_id")
  classId   String   @map("class_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([createdAt])
}

model Student {
  id                     String                  @id @default(cuid())
  admissionNo            String                  @map("admission_no")

  admissionDate          DateTime                @map("admission_date")
  dateOfBirth            DateTime                @map("date_of_birth")
  Religion               String?                 @map("religion")
  category               String?                 @map("category")
  caste                  String?                 @map("caste")
  motherTongue           String?                 @map("mother_tongue")
  languagesKnown         String                  @map("languages_known")
  fatherName             String                  @map("father_name")
  fatheremail            String?                 @map("father_email")
  fatherPhone            String                  @map("father_phone")
  fatherOccupation       String                  @map("father_occupation")
  motherName             String                  @map("mother_name")
  motherEmail            String?                 @map("mother_email")
  motherPhone            String                  @map("mother_phone")
  motherOccupation       String?                 @map("mother_occupation")
  guardianName           String                  @map("guardian_name")
  guardianRelation       String                  @map("guardian_relation")
  guardianEmail          String                  @map("guardian_email")
  guardianPhone          String                  @map("guardian_phone")
  guardianOccupation     String                  @map("guardian_occupation")
  guardianAddress        String                  @map("guardian_address")
  areSiblingStudying     String                  @map("are_siblings_studying")
  siblingName            String                  @map("sibling_name")
  siblingClass           String                  @map("sibling_class")
  siblingRollNo          String                  @map("sibling_roll_no")
  siblingAdmissionNo     String                  @map("sibling_admission_no")
  currentAddress         String                  @map("current_address")
  permanentAddress       String                  @map("permanent_address")
  vehicleNumber          String?                 @map("vehicle_number")
  routeId                String?                 @map("route_id")
  busPickupId            String?                 @map("bus_pickup_point")
  busStopId              String?                 @map("bus_stop_id")
  hostel_name            String?
  room_number            String?
  medicalCertificate     String                  @map("medical_certificate")
  transferCertificate    String                  @map("transfer_certificate")
  medicalCondition       String                  @map("medical_condition")
  allergies              String
  medicationName         String                  @map("medication_name")
  schoolName             String?                 @map("school_name")
  address                String?                 @map("address")
  schoolId               String                  @map("school_id")
  userId                 String                  @unique @map("user_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at")
  busId                  String?                 @map("bus_id")
  isDeleted              Boolean                 @default(false) @map("is_deleted")
  deletedAt              DateTime?               @map("deleted_at")
  deletedBy              String?                 @map("deleted_by")
  classId                String?
  status                 StudentLifecycleStatus  @default(ACTIVE) @map("status")
  AccommodationRequest   AccommodationRequest[]
  AssignmentSubmission   AssignmentSubmission[]
  assignmentViews        AssignmentView[]
  attendances            Attendance[]
  busAttendance          BusAttendance[]
  classLeaderboard       ClassLeaderboard?
  Complaint              Complaint[]
  enhancementLeaderboard EnhancementLeaderboard?
  ExamAttendance         ExamAttendance[]
  financeLedger          FinanceLedger[]
  HomeworkSubmission     HomeworkSubmission[]
  homeworkViews          HomeworkView[]
  hostelAllocations      HostelAllocation[]
  HostelFee              HostelFee[]
  MedicalEmergency       MedicalEmergency[]
  noticeReadStatuses     NoticeReadStatus[]
  OutpassRequest         OutpassRequest[]

  Payment             Payment[]
  paymentRequests     PaymentRequest[]
  results             Result[]
  buses               Bus?                     @relation(fields: [busId], references: [id], onDelete: Cascade)
  pickUpPoint         PickUpPoint?             @relation(fields: [busPickupId], references: [id])
  busStop             BusStop?                 @relation(fields: [busStopId], references: [id])
  class               Class?                   @relation(fields: [classId], references: [id])
  route               Route?                   @relation(fields: [routeId], references: [id])
  school              School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicRecords     StudentAcademicRecord[]
  studentEvaluations  StudentEvaluation[]
  StudentFaceData     StudentFaceData?
  studentFeePlans     StudentFeePlan[]
  remarks             StudentRemark[]
  dashboardSummary    StudentDashboardSummary?
  studentInvoiceItems StudentInvoiceItem[]
  StudentPromotion    StudentPromotion[]
  Grade               Grade[]                  @relation("GradeToStudent")
  parent              Parent[]                 @relation("ParentToStudent")
  Room                Room[]                   @relation("RoomToStudent")
  payments            Payment[]                @relation("StudentPayments")

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([userId])

  @@index([admissionNo])
  @@index([createdAt])
}

model StudentEvaluation {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  teacherId   String   @map("teacher_id")
  classId     String   @map("class_id")
  subjectId   String   @map("subject_id")
  score       Int      @map("score")
  type        String   @map("type")
  feedback    String?
  evaluatedAt DateTime @default(now()) @map("evaluated_at")
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([studentId, classId])
  @@index([evaluatedAt])
}

model StudentPromotion {
  id           String   @id @default(cuid())
  studentId    String
  fromClassId  String
  toClassId    String
  fromSection  String
  toSection    String
  academicYear String
  toSession    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fromClass    Class    @relation("FromClass", fields: [fromClassId], references: [id])
  student      Student  @relation(fields: [studentId], references: [id])
  toClass      Class    @relation("ToClass", fields: [toClassId], references: [id])

  @@index([studentId])
  @@index([fromClassId])
  @@index([toClassId])
  @@index([academicYear])
  @@index([createdAt])
  @@map("student_promotions")
}

model StudentFaceData {
  id            String   @id @default(cuid())
  studentId     String   @unique @map("student_id")
  faceImageUrl  String   @map("face_image_url")
  faceEmbedding Bytes    @map("face_embedding")
  createdAt     DateTime @default(now()) @map("created_at")
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Concession {
  id               String           @id @default(cuid()) @map("concession_id")
  schoolId         String           @map("school_id")
  studentFeePlanId String           @map("student_fee_plan_id")
  feeHeadId        String?          @map("fee_head_id")
  amount           Float            @map("amount")
  type             ConcessionType   @map("concession_type")
  reason           String           @map("reason")
  status           ConcessionStatus @default(PENDING) @map("status")
  approvedBy       String?          @map("approved_by")
  approvedAt       DateTime?        @map("approved_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  approver         User?            @relation(fields: [approvedBy], references: [id])
  feeHead          FeeHead?         @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFeePlan   StudentFeePlan   @relation(fields: [studentFeePlanId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentFeePlanId])
}

model StudentRegistrationLink {
  id                   String                       @id @default(cuid()) @map("id")
  schoolId             String                       @map("school_id")
  academicYearId       String?                      @map("academic_year_id")
  token                String                       @unique @map("token")
  expiresAt            DateTime                     @map("expires_at")
  isActive             Boolean                      @default(true) @map("is_active")
  createdByAdminId     String                       @map("created_by_admin_id")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at")
  academicYear         AcademicYear?                @relation(fields: [academicYearId], references: [id])
  school               School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  registrationRequests StudentRegistrationRequest[]

  @@index([schoolId])
  @@index([token])
  @@index([isActive, expiresAt])
}

model StudentRegistrationRequest {
  id                 String                    @id @default(cuid()) @map("id")
  schoolId           String                    @map("school_id")
  academicYearId     String?                   @map("academic_year_id")
  registrationLinkId String                    @map("registration_link_id")
  formData           Json                      @map("form_data")
  status             RegistrationRequestStatus @default(PENDING) @map("status")
  adminRemark        String?                   @map("admin_remark")
  submittedAt        DateTime                  @default(now()) @map("submitted_at")
  approvedAt         DateTime?                 @map("approved_at")
  approvedByAdminId  String?                   @map("approved_by_admin_id")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at")
  academicYear       AcademicYear?             @relation(fields: [academicYearId], references: [id])
  registrationLink   StudentRegistrationLink   @relation(fields: [registrationLinkId], references: [id], onDelete: Cascade)
  school             School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicYearId])
  @@index([registrationLinkId])
  @@index([status])
  @@index([schoolId, status])
}

enum ConcessionType {

  updatedAt   DateTime          @updatedAt @map("updated_at")
  job         JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_applications")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED

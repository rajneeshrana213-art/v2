model InvoiceLog {
  id            String   @id @default(cuid())
  invoiceNumber String   @map("invoice_number")
  userId        String   @map("user_id")
  downloadedAt  DateTime @default(now()) @map("downloaded_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeeHead {
  id                   String               @id @default(cuid()) @map("fee_head_id")
  schoolId             String               @map("school_id")
  name                 String               @map("name")
  description          String?              @map("description")
  revenueAccountId     String               @map("revenue_account_id")
  priority             Int                  @default(0) @map("priority")
  isActive             Boolean              @default(true) @map("is_active")
  type                 BillingType          @default(RECURRING) @map("fee_type")
  frequency            FeeFrequency         @default(MONTHLY) @map("fee_frequency")
  isMandatory          Boolean              @default(true) @map("is_mandatory")
  isConcessionEligible Boolean              @default(true) @map("is_concession_eligible")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at")
  concessions          Concession[]

enum AppModule {
  SMS
  LMS
  AI
}

enum SubStatus {
  ACTIVE
  EXPIRED
  TRIAL
  CANCELLED
}

/// Tracks subscriptions at the School level (B2B)
model SchoolModuleSubscription {
  id              String    @id @default(cuid())
  schoolId        String    @map("school_id")
  module          AppModule
  planId          String    @map("plan_id")
  status          SubStatus @default(ACTIVE)
  startDate       DateTime  @default(now()) @map("start_date")
  endDate         DateTime  @map("end_date")
  paymentRef      String?   @map("payment_reference")
  source          String    @default("SCHOOL_BASED") 
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, module, status])
  @@map("school_module_subscriptions")
}

/// Tracks subscriptions at the Individual User level (D2C)
model UserModuleSubscription {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  module          AppModule
  planId          String    @map("plan_id")
  status          SubStatus @default(ACTIVE)
  startDate       DateTime  @default(now()) @map("start_date")
  endDate         DateTime  @map("end_date")
  paymentRef      String?   @map("payment_reference")
  source          String    @default("DIRECT") 
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, module, status])
  @@map("user_module_subscriptions")
}


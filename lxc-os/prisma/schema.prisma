  studentId        String               @map("student_id")
  feeHeadId        String               @map("fee_head_id")
  month            Int?                 @map("billing_month")
  year             Int?                 @map("billing_year")
  grossAmount      Float                @map("gross_amount")
  concessionAmount Float                @default(0) @map("concession_amount")
  netAmount        Float                @map("net_amount")
  paidAmount       Float                @default(0) @map("paid_amount")
  balanceAmount    Float                @map("balance_amount")
  dueDate          DateTime?            @map("due_date")
  status           StudentInvoiceStatus @default(UNPAID) @map("status")
  notes            String?              @map("notes")

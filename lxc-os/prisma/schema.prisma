generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ******************* Super Admin ******************************

model User {
  id                      String                     @id @default(cuid()) @map("user_id")
  name                    String                     @map("full_name")
  userName                String?                    @unique @map("username")
  email                   String                     @unique @map("email_address")
  phone                   String                     @map("phone_number")
  profilePic              String?                    @map("profile_picture")
  password                String?                    @map("password_hash")
  address                 String                     @map("street_address")
  city                    String                     @map("city_name")
  state                   String                     @map("state_name")
  country                 String                     @map("country_name")
  pincode                 String                     @map("postal_code")
  bloodType               String                     @map("blood_type")
  sex                     UserSex                    @map("gender")
  schoolId                String?                    @map("school_id")
  reputation              Int                        @default(0) @map("user_reputation")
  coins                   Int                        @default(0) @map("reward_coins")
  redeemedBalance         Float                      @default(0.0) @map("redeemed_balance")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @default(now()) @updatedAt @map("updated_at")
  teacherId               String?                    @map("teacher_id")
  studentId               String?                    @map("student_id")
  parentId                String?                    @map("parent_id")
  libraryId               String?                    @map("library_id")
  hostel_id               String?
  transportId             String?                    @map("transport_id")
  accountId               String?                    @map("account_id")
  employeeType            EmployeeType?              @map("employee_type")
  departmentId            String?                    @map("department_id")
  designationId           String?                    @map("designation_id")
  role                    Role                       @default(superadmin) @map("user_role")
  lastOnline              DateTime?
  sidebarPreferences      Json?                      @map("sidebar_preferences")
  schoolGroupId           String?                    @map("school_group_id")
  isDeleted               Boolean                    @default(false) @map("is_deleted")
  deletedAt               DateTime?                  @map("deleted_at")
  deletedBy               String?                    @map("deleted_by")
  AccommodationRequest    AccommodationRequest[]
  account                 UserAccount?
  blocksReceived          Block[]                    @relation("BlockedUserRelation")
  blocksInitiated         Block[]                    @relation("BlockerRelation")
  callNotifications       CallNotification[]
  coinTransactions        CoinTransaction[]
  Comment                 Comment[]
  Competition             Competition[]
  Complaint               Complaint[]
  concessions             Concession[]
  ContactMessage          ContactMessage[]
  conductedDemos          Demo[]                     @relation("ConductedDemos")
  demos                   Demo[]
  disputes                Dispute[]
  disputeMessages         DisputeMessage[]
  doubts                  Doubt[]
  doubtReplies            DoubtReply[]
  Driver                  Driver?
  Duty                    Duty[]
  Employee                Employee?
  feedback                Feedback[]
  financeLedger           FinanceLedger[]
  financialPeriods        FinancialPeriod[]
  forumUserProfile        ForumUserProfile?
  friends1                Friend[]                   @relation("FriendsUser1")
  friends2                Friend[]                   @relation("FriendsUser2")
  receivedFriendRequests  FriendRequest[]            @relation("ReceivedFriendRequests")
  sentFriendRequests      FriendRequest[]            @relation("SentFriendRequests")
  GitHubToken             GitHubToken?
  groupsOwned             Group[]
  groupMemberships        GroupMember[]
  managedHostels          Hostel[]                   @relation("HostelWarden")
  inventoryTransactions   InventoryTransaction[]
  invoiceLogs             InvoiceLog[]
  assignedLeads           Lead[]                     @relation("AssignedLeads")
  leaderboard             Leaderboard?
  approvedLeaveRequests   LeaveRequest[]             @relation("LeaveApprover")
  LeaveRequest            LeaveRequest[]
  library                 Library?
  libraryMember           LibraryMember?
  sentMessages            Message[]                  @relation("MessageSender")
  newspaper               Newspaper[]
  NewspaperSubmission     NewspaperSubmission[]
  Notice                  Notice[]
  sentOfflineMessages     OfflineMessage[]           @relation("OfflineMessageSender")
  receivedOfflineMessages OfflineMessage[]           @relation("OfflineMessageReceiver")
  OtpToken                OtpToken[]
  pyq                     PYQ[]
  parent                  Parent?
  passwordResetToken      PasswordResetToken[]
  payrolls                Payroll[]
  CreatedProjects         Project[]                  @relation("ProjectCreator")
  LedProjects             Project[]                  @relation("ProjectLead")
  ProjectMember           ProjectMember[]
  quizzes                 QuizResult[]
  refreshTokens           RefreshToken[]
  reportsAgainst          Report[]                   @relation("ReportedUserRelation")
  reportsFiled            Report[]                   @relation("ReporterRelation")
  roadmaps                Roadmap[]
  createdCalls            ScheduledCall[]            @relation("CreatedCalls")
  callInvites             ScheduledCallParticipant[] @relation("CallInvites")
  ownedSchool             School?                    @relation("SchoolOwner")
  assignedOnboardings     SchoolOnboarding[]         @relation("AssignedOnboardings")
  student                 Student?
  assignedTasks           Task[]                     @relation("TaskAssignee")
  createdTasks            Task[]                     @relation("TaskCreator")
  TaskNotification        TaskNotification[]
  TaskWatcher             TaskWatcher[]
  teacher                 Teacher?
  assignedTickets         Ticket[]                   @relation("TicketAssignment")
  Ticket                  Ticket[]
  todo                    Todo[]
  Transaction             Transaction[]
  transport               Transport?
  department              Department?                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation             Designation?               @relation(fields: [designationId], references: [id], onDelete: Cascade)
  schoolGroup             SchoolGroup?               @relation("SchoolGroupUsers", fields: [schoolGroupId], references: [id])
  school                  School?                    @relation("SchoolUsers", fields: [schoolId], references: [id])
  generatedDocuments      IssuedDocument[]           @relation("IssuerDocuments")
  targetDocuments         IssuedDocument[]           @relation("TargetUserDocuments")
  schoolFeatureRequests   SchoolFeatureRequests[]
  ownedGroup              SchoolGroup?               @relation("GroupOwner")
  userPermissions         UserPermissions[]
  forumPayments           Payment[]                  @relation("ForumUserPayments")
  forumSubscriptions      subscription[]             @relation("ForumUserSubscriptions")

  @@index([schoolId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([schoolId, role])
  @@index([schoolId, isDeleted, role])
  @@index([createdAt])
  @@index([name])
  @@index([isDeleted])
  @@index([isDeleted, role])
  @@index([lastOnline])
  @@index([state])
  @@index([teacherId])
  @@index([studentId])
  @@index([parentId])
  @@index([departmentId])
  @@index([designationId])
  @@index([schoolGroupId])
  @@index([libraryId])
  @@index([transportId])
  @@index([accountId])

  // --- LMS fields and relations ---
  firstName             String?
  lastName              String?
  lmsAccountType        LmsAccountType?
  active                Boolean?  @default(true)
  approved              Boolean?  @default(true)
  image                 String?
  token                 String?
  resetPasswordExpires  DateTime?
  profile               Profile?
  instructorCourses     Course[]  @relation("InstructorCourses")
  enrolledCourses       Course[]  @relation("EnrolledStudents")
  ratingReviews         RatingAndReview[]

  aiStages              AiStage[]
  userModuleSubscriptions UserModuleSubscription[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement()) @map("token_id")
  token     String    @unique @map("reset_token")
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id        String   @id @default(cuid()) @map("refresh_token_id")
  token     String   @unique @map("refresh_token")
  userId    String   @map("user_id")
  revoked   Boolean  @default(false) @map("revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EventRole {
  id     Int     @id @default(autoincrement())
  name   String
  events Event[] @relation("EventRoles")
}

model ForumUserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  educationLevel    String?  @map("education_level")
  subjectsExpertise String?  @map("subjects_expertise")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAccount {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  school    School   @relation("UserAccounts", fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("Account")
}

model UserPermissions {
  id               Int      @id @default(autoincrement())
  guid             String   @unique @default(cuid()) @map("guid")
  userId           String?  @map("user_id") @db.VarChar(255)
  moduleName       String   @map("module_name") @db.VarChar(255)
  modulePermission String   @map("module_permission") @db.VarChar(255)
  status           Int      @default(1) @map("status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moduleName])
  @@index([status])
  @@map("user_permissions")
}

model Account {
  id             String          @id @default(cuid()) @map("account_id")
  schoolId       String          @map("school_id")
  academicYearId String          @map("academic_year_id")
  code           String          @map("account_code")
  name           String          @map("account_name")
  type           AccountType     @map("account_type")
  isSystem       Boolean         @default(false) @map("is_system")
  description    String?         @map("description")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  feeHeads       FeeHead[]       @relation("RevenueAccount")
  creditEntries  FinanceLedger[] @relation("CreditAccount")
  debitEntries   FinanceLedger[] @relation("DebitAccount")
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, code])
  @@index([schoolId, academicYearId, type])
  @@index([isSystem])
  @@map("finance_accounts")
}

model UserLoginLog {
  id        String   @id @default(cuid())
  userId    String
  role      String
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([role])
  @@index([timestamp])
}

enum UserSex {
  MALE
  FEMALE
  OTHERS
}

enum Role {
  superadmin
  admin
  teacher
  student
  parent
  library
  hostel
  transport
  account
  staff
  employee
  driver
  academics
  group_admin
  forum_user
}

enum UserType {
  STUDENT
  PARENT
  ADMIN
  TEACHER
  ACCOUNTANT
  LIBRARIAN
  RECEPTIONIST
  SUPER_ADMIN
}

enum ProjectRole {
  ADMIN
  DEVELOPER
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

// ******************* School ******************************

model School {
  id                          String                       @id @default(cuid()) @map("id")
  schoolName                  String                       @map("school_name")
  schoolLogo                  String?                      @map("school_logo")
  latitude                    Float?                       @map("latitude")
  longitude                   Float?                       @map("longitude")
  schoolCode                  String?                      @unique @map("school_code")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @default(now()) @updatedAt @map("updated_at")
  isActive                    Boolean                      @default(true) @map("is_active")
  userId                      String                       @unique @map("user_id")
  lunchEnd                    String?                      @default("13:00") @map("lunch_end")
  lunchStart                  String?                      @default("12:00") @map("lunch_start")
  periodDuration              Int                          @default(45) @map("period_duration")
  schoolClosing               String?                      @default("16:00") @map("school_closing")
  schoolOpening               String?                      @default("08:00") @map("school_opening")
  groupId                     String?                      @map("group_id")
  isDeleted                   Boolean                      @default(false) @map("is_deleted")
  deletedAt                   DateTime?                    @map("deleted_at")
  deletedBy                   String?                      @map("deleted_by")
  academicYears               AcademicYear[]
  userAccounts                UserAccount[]                @relation("UserAccounts")
  admissionCounters           AdmissionCounter[]
  buses                       Bus[]
  busMaintenanceAlerts        BusMaintenanceAlert[]
  busStops                    BusStop[]
  chequeDetails               ChequeDetail[]
  Class                       Class[]
  concessions                 Concession[]
  conductors                  Conductor[]
  departments                 Department[]
  designations                Designation[]
  drivers                     Driver[]
  driverBehaviorIncidents     DriverBehaviorIncident[]
  driverPerformanceScores     DriverPerformanceScore[]
  Duty                        Duty[]
  enhancementLeaderboards     EnhancementLeaderboard[]
  Event                       Event[]
  FeeGroup                    FeeGroup[]
  feeHeads                    FeeHead[]
  feeStructures               FeeStructure[]
  feedback                    Feedback[]
  financeLedger               FinanceLedger[]
  financialPeriods            FinancialPeriod[]
  Holiday                     Holiday[]
  hostels                     Hostel[]
  incharges                   Incharge[]
  inventoryItems              InventoryItem[]
  invoiceCounters             InvoiceCounter[]
  libraries                   Library[]
  Notice                      Notice[]
  NotificationChannel         NotificationChannel[]
  NotificationLog             NotificationLog[]
  NotificationTemplate        NotificationTemplate[]
  payments                    Payment[]                    @relation("SchoolPayments")
  paymentRequests             PaymentRequest[]
  paymentSecret               PaymentSecret?
  payrolls                    Payroll[]
  pickUpPoint                 PickUpPoint[]
  routes                      Route[]
  routeOptimizations          RouteOptimization[]
  salaryPayment               SalaryPayment[]
  group                       SchoolGroup?                 @relation("GroupSchools", fields: [groupId], references: [id])
  user                        User                         @relation("SchoolOwner", fields: [userId], references: [id], onDelete: Cascade)
  SchoolExpense               SchoolExpense[]
  SchoolExpenseCategory       SchoolExpenseCategory[]
  SchoolIncome                SchoolIncome[]
  schoolOnboarding            SchoolOnboarding?
  students                    Student[]
  studentFeePlans             StudentFeePlan[]
  studentRegistrationLinks    StudentRegistrationLink[]
  studentRegistrationRequests StudentRegistrationRequest[]
  Subject                     Subject[]
  teachers                    Teacher[]
  ticket                      Ticket[]
  todo                        Todo[]
  transports                  Transport[]
  transportAnalytics          TransportAnalytics[]
  TriggerNotification         TriggerNotification[]
  trips                       Trip[]
  users                       User[]                       @relation("SchoolUsers")
  visitors                    Visitor[]
  classSummaries              ClassSummary[]
  documentTemplates           DocumentTemplate[]
  accounts                    Account[]
  issuedDocuments             IssuedDocument[]
  msg91Templates              MSG91Template[]
  featureConfigs              SchoolFeatureConfig[]
  schoolFeatureRequests       SchoolFeatureRequests[]
  subscriptionConfig          SchoolSubscriptionConfig?
  schoolSummary               SchoolSummary?
  studentDashboardSummaries   StudentDashboardSummary[]
  studentInvoiceItems         StudentInvoiceItem[]
  subscription                subscription[]
  // ── FCM Push Notifications (new — no existing data affected) ──
  fcmTokens                   FcmToken[]
  pushNotificationLogs        PushNotificationLog[]

  @@index([isActive])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([schoolName])
  @@index([schoolCode])
  @@index([userId])
  @@index([groupId])
  @@index([isActive, isDeleted, createdAt])
  @@index([schoolName, isActive, isDeleted])

  schoolModuleSubscriptions SchoolModuleSubscription[]
}

// ─────────────────────────────────────────────────────────────────────────────
// FCM Push Notification Models  (NEW — purely additive, no existing data touched)
// ─────────────────────────────────────────────────────────────────────────────

/// Stores device FCM tokens. One user can have multiple devices.
model FcmToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  userType   String   @map("user_type")    // "student" | "teacher" | "parent" | "admin"
  token      String   @unique
  deviceInfo String?  @map("device_info")  // "android" | "ios"
  schoolId   String   @map("school_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId, userType])
  @@index([schoolId, userType])
  @@index([schoolId, isActive])
  @@map("fcm_tokens")
}

/// Logs every push notification sent (manual or automated trigger).
model PushNotificationLog {
  id           String   @id @default(cuid())
  title        String
  body         String
  data         Json?
  targetType   String   @map("target_type")    // "single" | "bulk" | "topic" | "role"
  target       String
  status       String   @default("sent")        // "sent" | "failed" | "partial"
  successCount Int      @default(0) @map("success_count")
  failureCount Int      @default(0) @map("failure_count")
  schoolId     String   @map("school_id")
  sentBy       String   @map("sent_by")
  trigger      String?                          // auto-trigger name, null = manual
  createdAt    DateTime @default(now()) @map("created_at")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([trigger])
  @@map("push_notification_logs")
}

/// Stores mobile app versioning and update prompts (Global settings)
model AppVersion {
  id              String   @id @default(cuid())
  currentVersion  String   @map("current_version")
  minimumVersion  String   @map("minimum_version")
  downloadUrl     String   @map("download_url")
  whatsNew        String   @map("whats_new")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy       String   @map("updated_by")

  @@map("app_versions")
}


model SchoolGroup {
  id            String         @id @default(cuid()) @map("group_id")
  name          String         @map("group_name")
  logo          String?        @map("group_logo")
  ownerId       String         @unique @map("owner_id")
  branchLimit   Int            @default(10) @map("branch_limit")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  isDeleted     Boolean        @default(false) @map("is_deleted")
  deletedAt     DateTime?      @map("deleted_at")
  deletedBy     String?        @map("deleted_by")
  schools       School[]       @relation("GroupSchools")
  users         User[]         @relation("SchoolGroupUsers")
  owner         User           @relation("GroupOwner", fields: [ownerId], references: [id])
  subscriptions subscription[] @relation("GroupSubscriptions")

  @@index([ownerId])
  @@index([isDeleted])
  @@index([name])
  @@map("school_groups")
}

model Department {
  id          String     @id @default(cuid()) @map("id")
  name        String     @map("depatment_name")
  description String?    @map("department_description")
  schoolId    String     @map("school_id")
  createdAt   DateTime   @default(now()) @map("department_created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("department_updated_at")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  deletedAt   DateTime?  @map("deleted_at")
  deletedBy   String?    @map("deleted_by")
  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Employee    Employee[]
  users       User[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
}

model Designation {
  id          String     @id @default(cuid()) @map("designation_id")
  name        String     @map("designation_name")
  description String?    @map("designation_description")
  schoolId    String     @map("school_id")
  createdAt   DateTime   @default(now()) @map("designation_created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("designation_updated_at")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  deletedAt   DateTime?  @map("deleted_at")
  deletedBy   String?    @map("deleted_by")
  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Employee    Employee[]
  users       User[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
}

model SchoolFeatureRequests {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.VarChar(255)
  schoolId   String   @map("school_id") @db.VarChar(255)
  moduleName String   @map("module_name") @db.VarChar(255)
  status     Int      @map("status")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([moduleName])
  @@map("school_feature_requests")
}

model SchoolExpense {
  id            String                @id @default(cuid())
  categoryId    String                @map("category_id")
  date          DateTime              @map("date")
  amount        Float
  description   String
  invoiceNumber String?               @map("invoice_number")
  paymentMethod paymentMethod         @map("payment_method")
  schoolId      String                @map("school_id")
  billUrl       String?               @map("bill_url")
  category      SchoolExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([categoryId])
  @@index([date])
  @@index([schoolId, date])
}

model SchoolExpenseCategory {
  id            String          @id @default(cuid())
  name          String
  schoolId      String          @map("school_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")
  SchoolExpense SchoolExpense[]
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SchoolIncome {
  id            String        @id @default(cuid())
  source        String
  date          DateTime      @map("date")
  amount        Float
  description   String
  schoolId      String        @map("school_id")
  invoiceNumber String?       @map("invoice_number")
  paymentMethod paymentMethod @map("payment_method")
  billUrl       String?       @map("bill_url")
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([date])
  @@index([schoolId, date])
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id])
  members     GroupMember[]
  messages    Message[]

  @@index([ownerId])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model FeeGroup {
  id          String   @id @default(cuid()) @map("fee_group_id")
  name        String   @map("name")
  description String?  @map("description")
  schoolId    String   @map("school_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolSummary {
  id                  String   @id @default(cuid()) @map("summary_id")
  schoolId            String   @unique @map("school_id")
  totalStudents       Int      @default(0) @map("total_students")
  activeStudents      Int      @default(0) @map("active_students")
  totalTeachers       Int      @default(0) @map("total_teachers")
  activeTeachers      Int      @default(0) @map("active_teachers")
  totalStaff          Int      @default(0) @map("total_staff")
  totalRevenue        Float    @default(0) @map("total_revenue")
  totalExpenses       Float    @default(0) @map("total_expenses")
  netRevenue          Float    @default(0) @map("net_revenue")
  pendingPayments     Float    @default(0) @map("pending_payments")
  activeSubscriptions Int      @default(0) @map("active_subscriptions")
  subscriptionStatus  String   @map("subscription_status")
  totalClasses        Int      @default(0) @map("total_classes")
  totalSubjects       Int      @default(0) @map("total_subjects")
  totalExams          Int      @default(0) @map("total_exams")

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<style>
  @page { size: A4 portrait; margin: 15mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; color: #1a1a2e; background: #fff; }
  .page { max-width: 794px; margin: 0 auto; }

  /* Header */
  .header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 20px; border-bottom: 3px solid #4f46e5; margin-bottom: 24px; }
  .school-info h1 { font-size: 20px; font-weight: 800; color: #4f46e5; }
  .school-info p { font-size: 10px; color: #666; margin-top: 2px; line-height: 1.5; }
  .school-logo { width: 70px; height: auto; margin-bottom: 6px; }
  .invoice-label { text-align: right; }
  .invoice-label h2 { font-size: 26px; font-weight: 900; color: #4f46e5; letter-spacing: 2px; }
  .invoice-label .inv-no { font-size: 11px; color: #888; margin-top: 4px; }
  .badge { display: inline-block; background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; border-radius: 20px; padding: 3px 12px; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 10px; }

  /* Info grid */
  .info-section { display: flex; justify-content: space-between; margin-bottom: 28px; }
  .info-box { flex: 1; }
  .info-box + .info-box { margin-left: 40px; text-align: right; }
  .info-box h3 { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #999; margin-bottom: 6px; border-bottom: 1px solid #f0f0f0; padding-bottom: 4px; }
  .info-box p { font-size: 11px; color: #333; line-height: 1.8; }
  .info-box .highlight { font-size: 13px; font-weight: 700; color: #1a1a2e; }

  /* Table */
  table { width: 100%; border-collapse: collapse; margin-bottom: 28px; }
  thead tr { background: #4f46e5; color: #fff; }
  thead th { padding: 10px 12px; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-align: left; }
  thead th.right { text-align: right; }
  thead th.center { text-align: center; }
  tbody tr:nth-child(even) { background: #f8f8ff; }
  tbody td { padding: 8px 12px; border-bottom: 1px solid #f0f0f0; font-size: 11px; color: #444; }
  tbody td.right { text-align: right; }
  tbody td.center { text-align: center; }

  /* Totals */
  .totals { display: flex; justify-content: flex-end; margin-bottom: 32px; }
  .totals-table { width: 280px; border-collapse: collapse; }
  .totals-table td { padding: 6px 12px; font-size: 11px; color: #555; }
  .totals-table td.right { text-align: right; }
  .totals-table tr.separator td { border-top: 1px solid #e0e0e0; padding-top: 10px; }
  .totals-table tr.grand td { background: #4f46e5; color: #fff; font-weight: 800; font-size: 14px; border-radius: 4px; padding: 8px 12px; }
  .totals-table tr.grand td.right { text-align: right; }

  /* Footer */
  .footer { margin-top: 40px; border-top: 1px dashed #ccc; padding-top: 16px; display: flex; justify-content: space-between; align-items: flex-end; }
  .footer .note { font-size: 10px; color: #888; max-width: 60%; line-height: 1.6; }
  .footer .sign { font-size: 10px; color: #555; text-align: right; border-top: 1px solid #ccc; padding-top: 8px; min-width: 150px; }
  .footer .sign span { font-weight: 700; display: block; margin-top: 4px; }

  /* Stamp area */
  .status-stamp {
    position: absolute;
    top: 60px;
    right: 20px;
    width: 100px;
    height: 100px;
    border: 3px solid #f59e0b;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-15deg);
    opacity: 0.5;
  }
  .status-stamp span { font-size: 11px; font-weight: 800; color: #f59e0b; text-align: center; line-height: 1.3; }
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div class="school-info">
      <% if (schoolLogo) { %>
        <img src="<%= schoolLogo %>" alt="Logo" class="school-logo" />
      <% } %>
      <h1><%= schoolName %></h1>
      <% if (schoolAddress) { %><p><%= schoolAddress %></p><% } %>
      <p>
        <% if (schoolPhone) { %><%= schoolPhone %><% } %>
        <% if (schoolPhone && schoolEmail) { %> | <% } %>
        <% if (schoolEmail) { %><%= schoolEmail %><% } %>
      </p>
    </div>
    <div class="invoice-label">
      <div class="badge">AD-HOC INVOICE</div>
      <h2>INVOICE</h2>
      <div class="inv-no"># <%= invoiceNumber %></div>
    </div>
  </div>

  <!-- Bill To / Invoice Details -->
  <div class="info-section">
    <div class="info-box">
      <h3>Bill To</h3>
      <p class="highlight"><%= studentName %></p>
      <p>Class: <%= className %></p>
      <p>Admission No: <%= admissionNo %></p>
      <% if (fatherName) { %><p>Father: <%= fatherName %></p><% } %>
    </div>
    <div class="info-box">
      <h3>Invoice Details</h3>
      <p><strong>Date:</strong> <%= invoiceDate %></p>
      <p><strong>Due Date:</strong> <%= dueDate %></p>
      <p><strong>Invoice #:</strong> <%= invoiceNumber %></p>
    </div>
  </div>

  <!-- Line Items -->
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Description</th>
        <th class="center">Qty</th>
        <th class="right">Unit Price</th>
        <th class="right">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(item, idx) { %>
      <tr>
        <td><%= idx + 1 %></td>
        <td><%= item.description %></td>
        <td class="center"><%= item.quantity %></td>
        <td class="right">₹<%= item.unitPrice.toFixed(2) %></td>
        <td class="right">₹<%= item.total.toFixed(2) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- Totals -->
  <div class="totals">
    <table class="totals-table">
      <tr>
        <td>Subtotal</td>
        <td class="right">₹<%= totalAmount.toFixed(2) %></td>
      </tr>
      <tr>
        <td style="color:#888;font-size:10px;">Tax (0%)</td>
        <td class="right" style="color:#888;font-size:10px;">₹0.00</td>
      </tr>
      <tr class="separator grand">
        <td><strong>Total Due</strong></td>
        <td class="right"><strong>₹<%= totalAmount.toFixed(2) %></strong></td>
      </tr>
    </table>
  </div>

  <!-- Notes -->
  <% if (description) { %>
  <div style="background:#f9f9ff;border-left:3px solid #4f46e5;padding:10px 14px;border-radius:0 6px 6px 0;margin-bottom:24px;font-size:11px;color:#555;">
    <strong>Notes:</strong> <%= description %>
  </div>
  <% } %>

  <!-- Footer -->
  <div class="footer">
    <div class="note">
      <strong>Payment Terms:</strong> Please settle this invoice by <strong><%= dueDate %></strong>.<br/>
      This is a computer-generated invoice and does not require a physical signature.<br/>
      For queries, contact the school accounts department.
    </div>
    <div class="sign">
      Authorized Signatory<br/>
      <span><%= schoolName %></span>
    </div>
  </div>

</div>
</body>
</html>

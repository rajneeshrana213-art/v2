<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error Report - LearnXChain</title>
    <style>
        :root {
            --primary: #4f46e5;
            --danger: #ef4444;
            --bg: #f9fafb;
            --card-bg: #ffffff;
            --text-main: #111827;
            --text-muted: #6b7280;
            --code-bg: #1e293b;
            --code-text: #f8fafc;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f3f4f6;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .wrapper {
            width: 100%;
            padding: 40px 20px;
        }
        .container {
            max-width: 700px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        .header {
            background-color: #ef4444;
            padding: 32px;
            text-align: center;
            color: #ffffff;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.025em;
            text-transform: uppercase;
        }
        .content {
            padding: 40px;
        }
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            background-color: #fef2f2;
            color: #ef4444;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 24px;
            text-transform: uppercase;
        }
        .error-message {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 8px;
            line-height: 1.4;
        }
        .timestamp {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 32px;
        }
        .section-title {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid #f3f4f6;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 32px;
        }
        .info-item b {
            display: block;
            font-size: 12px;
            color: #9ca3af;
            margin-bottom: 4px;
        }
        .info-item span {
            font-size: 14px;
            color: #111827;
            font-weight: 500;
        }
        .stack-container {
            background-color: #0f172a;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 32px;
            overflow-x: auto;
        }
        .stack-trace {
            margin: 0;
            font-family: 'JetBrains Mono', 'Fira Code', monospace;
            font-size: 13px;
            color: #94a3b8;
            line-height: 1.6;
            white-space: pre-wrap;
        }
        .context-container {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 32px;
        }
        .context-data {
            margin: 0;
            font-family: monospace;
            font-size: 13px;
            color: #334155;
            white-space: pre-wrap;
        }
        .footer {
            background-color: #f9fafb;
            padding: 32px;
            text-align: center;
            border-top: 1px solid #f3f4f6;
        }
        .footer p {
            margin: 0;
            font-size: 12px;
            color: #9ca3af;
        }
        .action-button {
            display: inline-block;
            margin-top: 24px;
            padding: 12px 24px;
            background-color: #4f46e5;
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: background-color 0.2s;
        }
        @media (max-width: 600px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
            .content {
                padding: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <h1>System Exception Detected</h1>
            </div>
            <div class="content">
                <div class="status-badge">Critical Alert</div>
                <div class="error-message"><%= error.message %></div>
                <div class="timestamp">Occurred at: <%= timestamp %></div>

                <div class="section-title">Environment Details</div>
                <div class="info-grid">
                    <div class="info-item">
                        <b>ENVIRONMENT</b>
                        <span><%= env.toUpperCase() %></span>
                    </div>
                    <div class="info-item">
                        <b>APP URL</b>
                        <span><%= appUrl %></span>
                    </div>
                    <div class="info-item">
                        <b>ERROR NAME</b>
                        <span><%= error.name %></span>
                    </div>
                    <div class="info-item">
                        <b>COMPONENT</b>
                        <span><%= context && context.component ? context.component : 'Unknown' %></span>
                    </div>
                </div>

                <% if (context && Object.keys(context).length > 0) { %>
                    <div class="section-title">Additional Context</div>
                    <div class="context-container">
                        <pre class="context-data"><%= JSON.stringify(context, null, 2) %></pre>
                    </div>
                <% } %>

                <div class="section-title">Stack Trace</div>
                <div class="stack-container">
                    <pre class="stack-trace"><%= error.stack || 'No stack trace available' %></pre>
                </div>

                <div style="text-align: center;">
                    <a href="<%= appUrl %>" class="action-button">Open Application</a>
                </div>
            </div>
            <div class="footer">
                <p>&copy; <%= new Date().getFullYear() %> LearnXChain Insight Engine</p>
                <p>Automated diagnostic reporting system</p>
            </div>
        </div>
    </div>
</body>
</html>

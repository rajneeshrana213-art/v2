<table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eef1f6">
  <tr>
    <td align="center" style="padding: 50px 15px;">

      <!-- Outer Wrapper -->
      <table width="720" cellpadding="0" cellspacing="0" border="0"
        style="background: #ffffff; border-radius: 22px; box-shadow: 0 30px 60px rgba(0,0,0,0.12); overflow: hidden;">

        <!-- HERO HEADER -->
        <tr>
          <td align="center" style="padding: 55px 40px;
                        background: radial-gradient(circle at top, #3a7bd5, #1e3c72);">

            <h1 style="margin: 0;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 34px;
                            font-weight: 800;
                            color: #ffffff;
                            letter-spacing: 0.3px;">
              Account Verification
            </h1>

            <p style="margin: 14px 0 0;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 17px;
                            color: #dfe9ff;
                            max-width: 520px;">
              LearnXChain Security Center
            </p>

          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding: 50px 55px; text-align: center;">

            <p style="margin: 0 0 20px;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 16px;
                            color: #222;">
              Dear <strong>
                <%= receiverName %>
              </strong>,
            </p>

            <p style="margin: 0 0 32px;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 16px;
                            color: #555;
                            line-height: 1.75;">
              Welcome! In order to log in and use the platform securely, you must first verify your account. Please use
              the One-Time Password (OTP) code below.
            </p>

            <!-- SECURITY CODE BOX -->
            <div
              style="background-color: #f9f9f9; border-radius: 12px; padding: 25px; display: inline-block; margin-bottom: 25px; border: 1px dashed #c4d4f2;">
              <p
                style="margin: 0 0 10px; font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 12px; color: #777; text-transform: uppercase; font-weight: bold; letter-spacing: 1px;">
                Your Verification Code
              </p>
              <h2 style="margin: 0; font-family: monospace; font-size: 42px; color: #1e3c72; letter-spacing: 6px;">
                <%= otp %>
              </h2>
            </div>

            <p style="margin: 35px 0 0;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 14px;
                            color: #666;
                            text-align: center;">
              This code has a short expiration time and should not be shared with anyone.
            </p>

          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td align="center" style="padding: 30px 40px;
                        background: #f6f8fc;
                        border-top: 1px solid #e6ebf3;">

            <p style="margin: 0;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 14px;
                            color: #666;
                            line-height: 1.7;">
              Need help?<br />
              📩 <strong>LearnXChain Support</strong> is always with you.
            </p>

          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eef1f6">
  <tr>
    <td align="center" style="padding: 50px 15px;">

      <!-- Outer Wrapper -->
      <table width="720" cellpadding="0" cellspacing="0" border="0"
        style="background: #ffffff; border-radius: 22px; box-shadow: 0 30px 60px rgba(0,0,0,0.12); overflow: hidden;">

        <!-- HERO HEADER -->
        <tr>
          <td align="center" style="padding: 55px 40px;
                        background: radial-gradient(circle at top, #dc3545, #8b0000);">

            <h1 style="margin: 0;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 34px;
                            font-weight: 800;
                            color: #ffffff;
                            letter-spacing: 0.3px;">
              System Alert
            </h1>

            <p style="margin: 14px 0 0;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 17px;
                            color: #ffe0e0;
                            max-width: 520px;">
              LearnXChain Diagnostics
            </p>

          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding: 40px 55px; text-align: left;">

            <!-- ERROR MESSAGE BOX -->
            <div
              style="background-color: #fff5f5; border-radius: 12px; padding: 25px; margin-bottom: 25px; border-left: 4px solid #dc3545;">
              <p
                style="margin: 0; font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 16px; color: #333; font-weight: 500; line-height: 1.6;">
                <%= error %>
              </p>
            </div>

            <!-- EXTRA DATA BOX -->
            <% if (typeof extraData !=='undefined' && extraData) { %>
              <div style="background-color: #f8f9fa; border-radius: 12px; padding: 20px; border: 1px solid #e9ecef;">
                <p
                  style="margin: 0 0 10px; font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 12px; color: #777; text-transform: uppercase; font-weight: bold; letter-spacing: 1px;">
                  Additional Context
                </p>
                <p
                  style="margin: 0; font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 14px; color: #555; word-break: break-all; white-space: pre-wrap;">
                  <%= extraData %>
                </p>
              </div>
              <% } %>

          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td align="center" style="padding: 30px 40px;
                        background: #f6f8fc;
                        border-top: 1px solid #e6ebf3;">

            <p style="margin: 0;
                            font-family: 'Segoe UI', Tahoma, sans-serif;
                            font-size: 14px;
                            color: #666;
                            line-height: 1.7;">
              This is an automated system alert.<br />
              📩 <strong>LearnXChain Support</strong> is monitoring the situation.
            </p>

          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>